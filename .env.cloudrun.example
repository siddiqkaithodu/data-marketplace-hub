# =============================================================================
# DataFlow — Cloud Run Environment Variables
# =============================================================================
# This file documents the env vars needed for Google Cloud Run deployment.
# Set these via:
#   - gcloud run deploy --set-env-vars "KEY=VALUE,..."
#   - Cloud Console → Cloud Run → Service → Edit & Deploy → Variables
#   - cloudbuild.yaml substitutions
# =============================================================================

# --------------- GCP / Cloud Build ---------------
# Used by cloudbuild.yaml (set via --substitutions or trigger config)
_GCP_PROJECT_ID=your-gcp-project-id
_GCP_REGION=us-central1
_ARTIFACT_REGISTRY_REPO=dataflow

# --------------- Backend (Cloud Run env vars) ---------------

# Cloud SQL connection string
# Format: postgresql://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://dataflow:your-secure-password@/dataflow?host=/cloudsql/your-project:us-central1:your-instance

# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key

# Must be "production" for Cloud Run
ENVIRONMENT=production

# CORS — set to your frontend Cloud Run URL
BACKEND_CORS_ORIGINS=https://dataflow-frontend-xxxxx-uc.a.run.app

# --------------- Frontend (build arg, NOT runtime env) ---------------

# Passed as --build-arg during docker build (Vite inlines it at build time)
VITE_API_BASE_URL=https://dataflow-backend-xxxxx-uc.a.run.app
