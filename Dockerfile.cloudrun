# =============================================================================
# Frontend Dockerfile for Google Cloud Run
# =============================================================================
# Usage:
#   docker build -f Dockerfile.cloudrun \
#     --build-arg VITE_API_BASE_URL=https://your-backend-url.run.app \
#     -t dataflow-frontend .
# =============================================================================

# --------------- Stage 1: Build ---------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for layer caching
COPY package*.json ./

# Install dependencies (ci for deterministic builds)
RUN npm ci

# Copy application source
COPY . .

# Strip GitHub Spark runtime import (depends on /_spark/* endpoints not available on Cloud Run)
RUN sed -i '/import.*@github\/spark\/spark/d' src/main.tsx

# Accept the backend API URL as a build argument
# Vite inlines VITE_* env vars at build time, so this must be a build arg
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build using Cloud Run vite config (strips Spark plugins that cause blank pages)
RUN npx vite build --config vite.config.cloudrun.ts

# --------------- Stage 2: Serve ---------------
FROM node:20-alpine

# Install a lightweight static file server
RUN npm install -g serve@latest

WORKDIR /app

# Copy only the built output from stage 1
COPY --from=builder /app/dist ./dist

# Create non-root user for security
RUN adduser -D appuser && chown -R appuser:appuser /app
USER appuser

# Cloud Run injects PORT env var (default 8080)
ENV PORT=8080
EXPOSE ${PORT}

# Serve the static files in single-page-app mode (-s)
CMD ["sh", "-c", "serve -s dist -l ${PORT}"]
